; AI Project Lab · 视觉验证 spike
; 只验证一件事：Godot 4 能不能用体素地块 + 引擎级光影，做出够好看的画面。
config_version=5

[application]

config/name="AI Project Lab"
run/main_scene="res://scenes/studio/component_studio.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

WorldState="*res://scripts/autoload/world_state.gd"
CostModel="*res://scripts/autoload/cost_model.gd"
StepRecorder="*res://scripts/autoload/step_recorder.gd"
WorldTools="*res://scripts/autoload/world_tools.gd"
McpBridge="*res://scripts/autoload/mcp_bridge.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

